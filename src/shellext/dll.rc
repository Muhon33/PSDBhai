#include <windows.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PSDBHAI_VERSION_NUM
PRODUCTVERSION PSDBHAI_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PSDBhai"
            VALUE "FileDescription", "PSDBhai - Explorer thumbnails for PSD and PSB files"
            VALUE "FileVersion", PSDBHAI_VERSION_STR
            VALUE "InternalName", "PSDBhai"
            VALUE "LegalCopyright", "Copyright (c) 2026 Muhon33. MIT License."
            VALUE "OriginalFilename", "PSDBhai.dll"
            VALUE "ProductName", "PSDBhai"
            VALUE "ProductVersion", PSDBHAI_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
