#include <windows.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PSDGLANCE_VERSION_NUM
PRODUCTVERSION PSDGLANCE_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PSDGlance"
            VALUE "FileDescription", "PSDGlance - Explorer thumbnails for PSD and PSB files"
            VALUE "FileVersion", PSDGLANCE_VERSION_STR
            VALUE "InternalName", "PSDGlance"
            VALUE "LegalCopyright", "Copyright (c) 2026 Muhon33. MIT License."
            VALUE "OriginalFilename", "PSDGlance.dll"
            VALUE "ProductName", "PSDGlance"
            VALUE "ProductVersion", PSDGLANCE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
