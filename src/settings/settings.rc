#include <windows.h>
#include "resource.h"
#include "version.h"

1 RT_MANIFEST "settings.manifest"
IDI_APP ICON "../../res/app.ico"

IDD_MAIN DIALOGEX 0, 0, 292, 224
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "PSDGlance"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    GROUPBOX        "Explorer thumbnails", -1, 7, 7, 278, 70
    AUTOCHECKBOX    "Show thumbnails for .psd files", IDC_PSD, 16, 22, 260, 10
    AUTOCHECKBOX    "Show thumbnails for .psb files", IDC_PSB, 16, 37, 260, 10
    LTEXT           "", IDC_STATUS, 16, 53, 262, 20

    GROUPBOX        "Quality", -1, 7, 82, 278, 48
    AUTORADIOBUTTON "Sharp: decode the full image for large icons (recommended)", IDC_SHARP, 16, 97, 260, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "Fast: use only Photoshop's small built-in preview", IDC_FAST, 16, 112, 260, 10

    GROUPBOX        "Thumbnail cache", -1, 7, 135, 278, 58
    LTEXT           "Windows keeps thumbnails it made earlier. Refresh after changing quality or updating PSDGlance. File Explorer windows will close and reopen.", -1, 16, 148, 262, 24
    PUSHBUTTON      "Refresh thumbnails...", IDC_REFRESH, 16, 174, 92, 14

    LTEXT           "", IDC_VERSION, 7, 204, 200, 10
    DEFPUSHBUTTON   "Close", IDCANCEL, 235, 201, 50, 14
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION PSDGLANCE_VERSION_NUM
PRODUCTVERSION PSDGLANCE_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "PSDGlance"
            VALUE "FileDescription", "PSDGlance"
            VALUE "FileVersion", PSDGLANCE_VERSION_STR
            VALUE "InternalName", "PSDGlance"
            VALUE "LegalCopyright", "Copyright (c) 2026 Muhon33. MIT License."
            VALUE "OriginalFilename", "PSDGlance.exe"
            VALUE "ProductName", "PSDGlance"
            VALUE "ProductVersion", PSDGLANCE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
